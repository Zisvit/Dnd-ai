{
  "$schema": "https://opencode.ai/config.json",
  // Не форматировать Python при правках инструментами в этом репозитории:
  // файлы не являются ruff-format-clean, и встроенный форматтер переписывает
  // затронутый файл целиком, раздувая диффы (см. коммит экономики c08a6bb).
  "formatter": {
    "ruff": {
      "disabled": true,
    },
    "uv": {
      "disabled": true,
    },
  },
}
