# ─── Провайдеры AI (OpenAI-совместимые эндпоинты) ───────────────────────────
# Бот перебирает провайдеров при исчерпании лимитов.
# Не все ключи обязательны — работают те, что заполнены.

# Основной бесплатный провайдер (обязателен для работы)
GROQ_API_KEY=
# Резерв: бесплатный free-tier Google Gemini
GEMINI_API_KEY=
# Крайний резерв: бесплатные :free модели OpenRouter
OPENROUTER_API_KEY=

# Локальный провайдер (Ollama) — без лимитов, если запущен локально
# OLLAMA_BASE_URL=http://localhost:11434/v1/chat/completions
# OLLAMA_MODEL=llama3.2:3b
# Удалённый Ollama-сервер (укажи свой адрес; не коммить реальный IP)
# OLLAMA_SERVER_URL=http://192.168.1.100:11434

# Задержка вывода (сек): 0.008 - плавно, 0.0 - мгновенно
OUTPUT_DELAY=0.008

# Режим стриминга (живой вывод по токенам). Пусто/0 = ВЫКЛ (по умолчанию,
# сохраняется подсветка разметки {{}}), 1 = живой вывод без подсветки.
STREAM_MODE=0

# Режим эмодзи. 1 (по умолчанию) = с эмодзи, 0 = только текст.
# Можно переключить в игре: !эмодзи выкл / !эмодзи вкл
EMOJI=1

# ANSI-цвета в выводе. 1 (по умолчанию) = включены, 0 = чистый текст.
COLOR=1

# Уровень лога: DEBUG / INFO / WARNING (по умолчанию) / ERROR
LOG_LEVEL=WARNING

# Имя игрока по умолчанию
DEFAULT_PLAYER_NAME=player
